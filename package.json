{
  "name": "starlight-luau-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for starlight-luau and its demo site.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/libraries/ts/*/*",
      "packages/runtimes/*"
