      "@types/node": "26.6.6",
      "astro": "7.4.12"
    }
  },
  "devDependencies": {
    "@sgt-build/oxlint-config": "file:../sergeant/dist/npm/sgt-build-oxlint-config-0.15.0.tgz",
    "@sgt-build/tsconfig": "file:../sergeant/dist/npm/sgt-build-tsconfig-0.15.0.tgz",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
