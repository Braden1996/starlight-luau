{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Package source (runs in Node under Astro, and in Bun)",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "skipLibCheck": true,
    "rootDir": "."
  },
  "include": ["index.ts", "src", "scripts"],
  "exclude": ["src/**/*.test.ts"]
}
